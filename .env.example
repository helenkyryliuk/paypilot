# Server (never exposed to the browser)
DATABASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PORT=5000

# Browser (Vite inlines VITE_* variables into the built JS at build time)
VITE_STRIPE_PUBLISHABLE_KEY=
# Optional. Defaults to "/api" (same origin), which works locally and on Vercel.
# VITE_API_URL=
